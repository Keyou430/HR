# ── Hermes Gateway (AI) ──────────────────────────────────────
HERMES_MODE=mock
HERMES_BASE_URL=http://localhost:8001
HERMES_MODEL=hermes-default
HERMES_API_KEY=sk-your-deepseek-api-key
# ── FastGPT Gateway (Knowledge Base) ─────────────────────────
FASTGPT_MODE=mock
FASTGPT_BASE_URL=http://127.0.0.1:3100/api
FASTGPT_API_KEY=your-fastgpt-api-key
# ── Integration Embed URLs ───────────────────────────────────
FEISHU_EMBED_URL=https://www.feishu.cn/
DINGTALK_EMBED_URL=https://www.dingtalk.com/
# ── Database ──────────────────────────────────────────────────
# SQLite for dev; PostgreSQL for Docker / production
# DATABASE_URL=sqlite:///D:/Replica/backend/replica_platform.db
DATABASE_URL=postgresql+psycopg2://hr_user:hr_password@localhost:5432/hr_platform
# PostgreSQL connection details (used by Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hr_platform
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_password
POOL_SIZE=10
MAX_OVERFLOW=20
# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
# ── Admin Bootstrap ───────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_EMAIL=admin@example.com
# ── Backup ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
