# ── Hermes Gateway ──────────────────────────────────────────
HERMES_MODE=mock
HERMES_BASE_URL=http://localhost:8001
HERMES_MODEL=hermes-default
# ── FastGPT Gateway ─────────────────────────────────────────
FASTGPT_MODE=mock
FASTGPT_BASE_URL=http://127.0.0.1:3100/api
# ── Integration Embed URLs ───────────────────────────────────
FEISHU_EMBED_URL=https://www.feishu.cn/
DINGTALK_EMBED_URL=https://www.dingtalk.com/
# ── Database ──────────────────────────────────────────────────
# SQLite for dev; PostgreSQL for production
# DATABASE_URL=sqlite:///D:/Replica/backend/replica_platform.db
DATABASE_URL=postgresql+psycopg2://replica:replica@localhost:5432/replica
# PostgreSQL connection details (used by Docker Compose)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=replica
# POSTGRES_USER=replica
# POSTGRES_PASSWORD=replica
# POOL_SIZE=10
# MAX_OVERFLOW=20
# ── Admin Bootstrap ───────────────────────────────────────────
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-on-first-login
# ADMIN_EMAIL=admin@example.com
# ── Backup ────────────────────────────────────────────────────
# BACKUP_RETENTION_DAYS=14
